        "create_directory": {
          "default": "allow"
        },
        "mcp:mcp-server-context7:query-docs": {
          "default": "allow"
        },
        "terminal": {
          "always_deny": [
            {
              "pattern": "find / .*"
            }
          ],
          "always_confirm": [],
          "default": "allow",
          "always_allow": []
        }
      }
