      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-luna",
        "enable_thinking": true,
        "effort": "high",
        "speed": "fast"
      },
      {
        "provider": "opencode",
        "model": "go/gpt-5.6-luna",
