  "language_models": {
    "opencode": {
      "show_zen_models": false,
      "show_go_models": true,
      "available_models": [
        {
          "display_name": "Omen Alpha",
          "name": "omen-alpha",
          "max_tokens": 200000,
          "protocol": "openai_chat",
          "subscription": "go",
          "reasoning_effort_levels": [ "low", "high" ]
        }
      ]
    },
    "open_router": {
      "available_models": [
        {
          "name": "z-ai/glm-5.2",
          "max_tokens": 150000,
          "supports_tools": true,
          "mode": {
            "type": "thinking"
          },
          "provider": {
            "only": ["baidu/fp8", "streamlake/fp8"]
          }
        },
      ]
    }
  },
  "semantic_tokens": "combined",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
