        "mode": "agent-full-access"
      },
      "type": "registry"
    }
  },
  "languages": {
    "Rust": {
      "show_edit_predictions": false
    }
  },
  "format_on_save": "off",
  "show_edit_predictions": false,
  "debugger": {
    "button": true
  },
  "agent": {
    "show_turn_stats": true,
    "terminal_init_command": "",
