  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left"
  },
  "show_whitespaces": "selection",
  "remove_trailing_whitespace_on_save": false,
  "edit_predictions": {
    "provider": "copilot",
    "mode": "subtle"
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "collaboration_mode": "default",
        "model": "gpt-5.6-sol",
